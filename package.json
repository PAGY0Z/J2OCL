{
  "name": "@pagy0z/j2ocl",
  "version": "0.0.0",
  "private": false,
  "description": "Write and run real OpenCL GPU kernels in TypeScript, compiled ahead-of-time to native OpenCL C.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PAGY0Z/J2OCL.git"
  },
  "homepage": "https://github.com/PAGY0Z/J2OCL#readme",
  "bugs": {
    "url": "https://github.com/PAGY0Z/J2OCL/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execute": {
      "types": "./dist/execute.d.ts",
      "default": "./dist/execute.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "coverage:badges": "node .github/scripts/generate-coverage-badges.mjs"
  },
  "bin": {
    "j2ocl": "./dist/cli/bin.js"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@node-3d/opencl": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@node-3d/opencl@3.0.0": true,
    "@node-3d/segfault@4.0.1": true,
    "esbuild@0.28.2": true
  }
}
